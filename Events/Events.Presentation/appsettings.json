{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost; Port=5438; Database=events; Username=postgres; Password=postgres"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "JwtTokenSettings": {
    "Issuer": "TokenGeneratorService",
    "Audience": "EventManagement.Presentation",
    "Expires": 30
  },
  "BookingConfirmedConsumerSettings": {
    "BootstrapServers": "localhost:9092",
    "GroupId": "BookingConfirmedConsumers",
    "Topic": "booking-confirmed"
  },
  "BookingCancelledConsumerSettings": {
    "BootstrapServers": "localhost:9092",
    "GroupId": "BookingCancelledConsumers",
    "Topic": "booking-cancelled"
  }
}
