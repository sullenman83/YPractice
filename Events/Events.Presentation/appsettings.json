{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost; Port=5438; Database=events; Username=postgres"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "JwtTokenSettings": {
    "Issuer": "TokenGeneratorService",
    "Audience": "EventManagement.Presentation",
    "Expires": 30
  },
  "BookingConfirmedConsumerSettings": {
    "BootstrapServers": "localhost:9092",
    "GroupId": "BookingConfirmedConsumers",
    "Topic": "booking-confirmed"
  },
  "BookingCancelledConsumerSettings": {
    "BootstrapServers": "localhost:9092",
    "GroupId": "BookingCancelledConsumers",
    "Topic": "booking-cancelled"
  },
  "RedisSettings": {
    "EndPoints": "localhost:6379",
    "ConnectTimeout": 5000,
    "SyncTimeout": 3000,
    "AsyncTimeout": 3000,
    "AbortOnConnectFail": "false"
  },
  "TTLSettings": {
    "EventTTL": 60,
    "Top10TTL": 900
  }
}
