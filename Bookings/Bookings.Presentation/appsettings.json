{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost; Port=5432; Database=Bookings; Username=user; Password=user"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "JwtTokenSettings": {
    "Issuer": "TokenGeneratorService",
    "Audience": "EventManagement.Presentation",
    "Expires": 30
  },
  "BackgroundProducerServiceSettings": {
    "PollingInterval": 5000,
    "Topics": {
      "BookingConfirmed": "booking-confirmed",
      "BookingCancelled": "booking-cancelled"
    }
  },

  "BookingProducerSettings": {
    "BootstrapServer": "localhost:9092"
  },

  "EventSeatsNotReservedConsumerSettings": {
    "BootstrapServers": "localhost:9092",
    "GroupId": "EventSeatsNotReservedConsumers"
  },
  "EventSeatsReservedConsumerSettings": {
    "BootstrapServers": "localhost:9092",
    "GroupId": "EventSeatsReservedConsumers"
  } 
}