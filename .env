STACK_VERSION=7.6.0

KAFKA_HOST=kafka
KAFKA_INTERNAL_PORT=29092
KAFKA_EXTERNAL_PORT=9092
KAFKA_CONTROLLER_PORT=9093
KAFKA_BOOTSTRAP_SERVERS=${KAFKA_HOST}:${KAFKA_INTERNAL_PORT}
KAFKA_TOPICS=booking-confirmed,booking-cancelled

DB_USER=postgres
DB_PASSWORD=postgres

BOOKINGS_DB_EXTERNAL_PORT=5437
EVENTS_DB_EXTERNAL_PORT=5438
USERS_DB_EXTERNAL_PORT=5439


BOOKINGS_DB_HOST=bookings-db
BOOKINGS_DB_PORT=5432
BOOKINGS_DB_NAME=bookings

EVENTS_DB_HOST=events-db
EVENTS_DB_PORT=5432
EVENTS_DB_NAME=events

USERS_DB_HOST=users-db
USERS_DB_PORT=5432
USERS_DB_NAME=users

BOOKINGS_API_PORT=5001
EVENTS_API_PORT=5002
USERS_API_PORT=5003

REDIS_HOST=redis
REDIS_INTERNAL_PORT=6379
REDIS_EXTERNAL_PORT=6379
REDIS_PASSWORD=redispassword
REDIS_ENDPOINTS=${REDIS_HOST}:${REDIS_INTERNAL_PORT}

PROMETHEUS_INTERNAL_PORT=9090
PROMETHEUS_EXTERNAL_PORT=9090

JAEGER_HOST=eventapi-jaeger
OTLP_ENDPOINT=http://${JAEGER_HOST}:4318/v1/traces
OTLP_PROTOCOL=HttpProtobuf
OTLP_DELAY=2000
OTLP_TIMEOUT=3000

JAEGER_UI_INTENAL_PORT=16686
JAEGER_UI_EXTERNAL_PORT=16686

JAEGER_GRPC_EXTERNAL_PORT=4317
JAEGER_GRPC_INTERNAL_PORT=4317

JAEGER_HTTP_EXTERNAL_PORT=4318
JAEGER_HTTP_INTERNAL_PORT=4318

GRAFANA_EXTERNAL_PORT=3000
GRAFAN_INTERNAL_PORT=3000
