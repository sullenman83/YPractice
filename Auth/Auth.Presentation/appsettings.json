{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost; Port=5439; Database=users; Username=postgres; Password=postgres"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",

  "JwtTokenSettings": {
    "Issuer": "TokenGeneratorService",
    "Audience": "EventManagement.Presentation",
    "Expires": 30
  },

  "OtlpSettings": {
    "Endpoint": "http://localhost:4318/v1/traces",
    "Protocol": "HttpProtobuf",
    "ScheduledDelayMilliseconds": 2000,
    "ExporterTimeoutMilliseconds": 3000
  }
}
